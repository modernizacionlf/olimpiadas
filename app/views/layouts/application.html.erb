<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Olimpiadas Las Flores" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header>
      <div> <h1>LOGO</h1></div>
      <nav class="navbar">
        <% if Current.user.present? && Current.user.admin? %>
          <ul class="admin-links">
            <li><%= link_to admin_releases_path %></li>
            <li><%= link_to admin_games_path %></li>
            <li><%= link_to admin_gallery_path %></li>
          </ul>
        <% else %>
          <ul class ="main-links">
            <li class="li-home"><%= link_to "home", root_path %></li>
            <li class="li-noticias"><%= link_to "noticias", releases_path %></li>
            <li class="li-deportes"><%= link_to "deportes", sports_path %></li>
            <li class="li-culturales"><%= link_to "culturales", cultural_index_path %></li>
            <li class="li-promos"><%= link_to "promos", promo_index_path %></li>
            <li class="li-galeria"><%= link_to "galeria", gallery_index_path %></li>
          </ul>

          <ul class="login">
            <%= link_to 'Iniciar Sesión', new_session_path %>
          </ul>
        <% end %>
      </nav>
    </header>

    <main>
      <%= yield %>
    </main>
  </body>

  <footer>
    <div>
      <img class="logo-muni" src="<%= asset_path('logo_modernizacion_negro.png') %>"></img>
    </div>
    <div>
      <ul>
        <li>
          <a href="https://www.google.com/url?sa=t&source=web&rct=j&opi=89978449&url=https://www.instagram.com/juventudeslasflores/%3Fhl%3Des-la&ved=2ahUKEwiCkv7EltaQAxWkqJUCHTf8GsIQFnoECCEQAQ&usg=AOvVaw0hPzQC2MjopU8FTkYIC-pP" target="_blank">
            Instagram
          </a>
        </li>
        <li>
          <a href="https://www.google.com/url?sa=t&source=web&rct=j&opi=89978449&url=https://www.facebook.com/juventudeslasflores/&ved=2ahUKEwj9nv3Nl9aQAxWcLbkGHfdOA0cQFnoECCEQAQ&usg=AOvVaw3EXfXxU922VYUpv7ECeWYO" target="_blank">
            Facebook
          </a>
        </li>
        <li>
          <p>Hecho por Modernización y PROMOXV: Theo Lopez - Lautaro Solei</p>
        </li>
      </u>
    </div>
    <div><p>&copy; Ejemplo: Juventudes/Modernizacion Las Flores</p></div>
    <div>
      <img>TODO LOGO OLIM</img>
    </div>
  </footer>
</html>
