<div class="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-50 dark:from-slate-900 dark:via-slate-800 dark:to-slate-900">
  <div class="absolute inset-0 opacity-20 pointer-events-none">
    <div class="absolute top-40 right-20 w-64 h-64 bg-blue-400 rounded-full blur-3xl"></div>
    <div class="absolute bottom-40 left-20 w-80 h-80 bg-indigo-400 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="mb-8">
      <%= link_to releases_path, class: "inline-flex items-center gap-2 text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors duration-300 group" do %>
        <svg class="w-5 h-5 transform group-hover:-translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        <span class="font-medium">Volver a Noticias</span>
      <% end %>
    </div>

    <article class="bg-white dark:bg-slate-800 rounded-3xl border-1 border-solid border-neutral-300 dark:border-slate-700 overflow-hidden">
      <div class="relative">
        <% if @release.image.attached? %>
          <div class="relative h-96 lg:h-[32rem] overflow-hidden">
            <%= image_tag @release.image,
                class: "w-full h-full object-cover",
                alt: @release.title %>
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
          </div>
        <% else %>
          <div class="relative h-96 lg:h-[32rem] bg-neutral-50 flex items-center justify-center">
            <svg class="w-32 h-32 text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
            </svg>
          </div>
        <% end %>
      </div>

      <div class="px-6 sm:px-8 lg:px-12 py-10 lg:py-14">
        <div class="flex flex-wrap items-center gap-4 mb-8 pb-6 border-b border-slate-200 dark:border-slate-700">
          <% if @release.respond_to?(:created_at) %>
            <div class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              <span><%= @release.created_at.strftime("%d de %B, %Y") %></span>
            </div>
          <% end %>

          <% if @release.respond_to?(:updated_at) && @release.updated_at != @release.created_at %>
            <div class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
              </svg>
              <span>Actualizado el <%= @release.updated_at.strftime("%d de %B, %Y") %></span>
            </div>
          <% end %>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-slate-900 dark:text-white mb-8 leading-tight">
          <%= @release.title.titleize %>
        </h1>

        <div class="prose prose-lg prose-slate dark:prose-invert max-w-none">
          <div class="text-xl text-slate-700 dark:text-slate-300 leading-relaxed space-y-6">
            <%= simple_format(@release.description.capitalize, class: "whitespace-pre-line") %>
          </div>
        </div>

        <div class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-700">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
            <div class="flex items-center gap-3">
              <span class="text-sm font-medium text-slate-600 dark:text-slate-400">Compartir:</span>
              <div class="flex gap-2">
                <a href="https://twitter.com/intent/tweet?text=<%= CGI.escape(@release.title) %>&url=<%= CGI.escape(request.original_url) %>" 
                   target="_blank"
                   rel="noopener noreferrer"
                   class="w-10 h-10 flex items-center justify-center rounded-full bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-400 hover:bg-blue-500 hover:text-white transition-colors duration-300">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                </a>

                <a href="https://www.facebook.com/sharer/sharer.php?u=<%= CGI.escape(request.original_url) %>" 
                   target="_blank"
                   rel="noopener noreferrer"
                   class="w-10 h-10 flex items-center justify-center rounded-full bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-400 hover:bg-blue-600 hover:text-white transition-colors duration-300">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                  </svg>
                </a>

                <a href="https://api.whatsapp.com/send?text=<%= CGI.escape("#{@release.title} #{request.original_url}") %>" 
                   target="_blank"
                   rel="noopener noreferrer"
                   class="w-10 h-10 flex items-center justify-center rounded-full bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-400 hover:bg-green-500 hover:text-white transition-colors duration-300">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </article>

    <% if defined?(@related_releases) && @related_releases.present? %>
      <div class="mt-16">
        <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-8">
          Noticias Relacionadas
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <% @related_releases.each do |related| %>
            <%= link_to release_path(related), class: "group block" do %>
              <article class="bg-white dark:bg-slate-800 rounded-2xl transition-all duration-300 overflow-hidden h-full flex flex-col hover:-translate-y-1">
                <% if related.image.attached? %>
                  <div class="relative h-48 overflow-hidden">
                    <%= image_tag related.image,
                        class: "w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500",
                        alt: related.title %>
                  </div>
                <% end %>
                
                <div class="p-5 flex-1 flex flex-col">
                  <h5 class="text-lg font-bold text-slate-900 dark:text-white mb-2 leading-tight line-clamp-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors duration-300">
                    <%= related.title.titleize %>
                  </h5>
                  
                  <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed line-clamp-2 flex-1">
                    <%= related.description.capitalize %>
                  </p>

                  <div class="mt-3 pt-3 border-t border-slate-200 dark:border-slate-700">
                    <span class="text-blue-600 dark:text-blue-400 font-semibold text-sm group-hover:underline">
                      Leer artículo
                    </span>
                  </div>
                </div>
              </article>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
