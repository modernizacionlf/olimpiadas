<div class="-culture-container">
  <% if @culturals.any? %>
    <% @culturals.each do |cultural| %>
      <div class="sport">
        <%= link_to cultural_path(cultural) do %>
          <img src=<%= url_for(cultural.image) %>></img>
        <% end %>
        <h2><%= cultural.title.titleize %></h2>
      </div>
    <% end %>
  <% end %>
</div>
