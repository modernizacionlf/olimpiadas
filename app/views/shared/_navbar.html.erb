      <!-- Mobile menu button -->
      <div class="flex md:hidden">
        <button type="button" 
                data-action="click->navbar#toggleMobile"
                data-navbar-target="mobileButton"
                class="inline-flex items-center justify-center p-2 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors duration-300">
          <svg class="w-6 h-6" data-navbar-target="menuIcon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
