<div class="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-50 dark:from-slate-900 dark:via-slate-800 dark:to-slate-900">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="mb-16">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-6">
        <div>
          <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold text-slate-900 dark:text-white mb-3 tracking-tight">
            Deportes
          </h1>
        </div>
      </div>

      <p class="text-lg text-slate-600 dark:text-slate-300 max-w-3xl">
        Explora todas las disciplinas deportivas de las Olimpíadas. Haz clic en cada deporte para ver más información, resultados y participantes.
      </p>
    </div>

    <% if @sports.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        <% @sports.each do |sport| %>
          <%= link_to sport_path(sport), class: "group block" do %>
            <article class="relative h-full bg-white dark:bg-slate-800 rounded-2xl transition-all duration-300 overflow-hidden hover:-translate-y-2 border-1 border-neutral-300 hover:border-blue-600 dark:border-slate-700">
              <div class="relative p-8 flex flex-col items-center text-center min-h-[200px]">
                <div class="mb-5 relative">
                  <div class="absolute inset-0 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-2xl blur-lg opacity-50 group-hover:opacity-70 transition-opacity duration-300"></div>
                </div>

                <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-3 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors duration-300">
                  <%= sport.name.titleize %>
                </h2>

                <div class="mt-6 flex items-center gap-2 text-blue-600 dark:text-blue-400 font-semibold text-sm">
                  <span>Ver deporte</span>
                  <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </div>
              </div>
            </article>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <!-- Estado vacío -->
      <div class="flex flex-col items-center justify-center py-20">
        <div class="w-24 h-24 bg-slate-100 dark:bg-slate-800 rounded-full flex items-center justify-center mb-6">
          <svg class="w-12 h-12 text-slate-400 dark:text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">
          No hay deportes disponibles
        </h3>
        <p class="text-slate-600 dark:text-slate-400 text-center max-w-md">
          Actualmente no hay deportes registrados en las olimpíadas.
        </p>
      </div>
    <% end %>

    <div class="mt-20 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 border-1 border-neutral-300 dark:border-slate-700">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/30 rounded-xl flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-slate-900 dark:text-white mb-2">
              Información Detallada
            </h3>
            <p class="text-sm text-slate-600 dark:text-slate-400">
              Cada deporte contiene información completa sobre reglas, participantes y resultados.
            </p>
          </div>
        </div>
      </div>

      <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 border border-slate-200 dark:border-slate-700">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 bg-indigo-100 dark:bg-indigo-900/30 rounded-xl flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-slate-900 dark:text-white mb-2">
              Resultados en Vivo
            </h3>
            <p class="text-sm text-slate-600 dark:text-slate-400">
              Sigue los resultados actualizados de cada competencia deportiva.
            </p>
          </div>
        </div>
      </div>

      <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 border border-slate-200 dark:border-slate-700">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 bg-purple-100 dark:bg-purple-900/30 rounded-xl flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-slate-900 dark:text-white mb-2">
              Participantes
            </h3>
            <p class="text-sm text-slate-600 dark:text-slate-400">
              Conoce a todos los estudiantes que compiten en cada disciplina.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
