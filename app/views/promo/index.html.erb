<div class="promos-container">
  <% Institute.all.each do |institute| %>
    <p><%= institute.name.titleize %></p>
    <% institute.promos.each do |promo| %>
      <p><%= promo.name.titleize %></p>
      <% promo.students.each do |student| %>
        <p><%= student.full_name.titleize %></p>
      <% end %>
    <% end %>
  <% end %>
</div>
