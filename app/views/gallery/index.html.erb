<div class="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-50 dark:from-slate-900 dark:via-slate-800 dark:to-slate-900">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="mb-16">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-6">
        <div>
          <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold text-slate-900 dark:text-white mb-3 tracking-tight">
            Galería
          </h1>
        </div>
      </div>

      <p class="text-lg text-slate-600 dark:text-slate-300 max-w-3xl">
        Revive los mejores momentos de las Olimpíadas. Haz clic en cualquier imagen para verla en tamaño completo.
      </p>
    </div>

    <% if @photos&.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @photos.each_with_index do |photo, index| %>
          <article class="group relative bg-white dark:bg-slate-800 rounded-2xl border-1 border-solid border-neutral-300 transition-all duration-300 overflow-hidden cursor-pointer border border-slate-200 dark:border-slate-700"
                   data-image-index="<%= index %>"
                   onclick="openLightbox(<%= index %>)">

            <div class="relative aspect-[4/3] overflow-hidden">
              <% if photo.blob.present? %>
                <%= image_tag photo,
                    class: "w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700",
                    alt: "Foto #{index + 1}" %>
              <% else %>
                <div class="w-full h-full bg-neutral-50 flex items-center justify-center">
                  <svg class="w-20 h-20 text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                </div>
              <% end %>

              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                <div class="transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
                  <div class="w-12 h-12 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="flex flex-col items-center justify-center py-20">
        <div class="w-24 h-24 bg-slate-100 dark:bg-slate-800 rounded-full flex items-center justify-center mb-6">
          <svg class="w-12 h-12 text-slate-400 dark:text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">
          No hay fotos disponibles
        </h3>
        <p class="text-slate-600 dark:text-slate-400 text-center max-w-md">
          Las fotos de las Olimpíadas estarán disponibles próximamente.
        </p>
      </div>
    <% end %>
  </div>
</div>

<div id="lightbox" class="fixed inset-0 bg-black/95 backdrop-blur-sm z-50 hidden items-center justify-center p-4" onclick="closeLightbox()">
  <div class="relative w-full max-w-7xl" onclick="event.stopPropagation()">
    <button onclick="closeLightbox()" class="absolute -top-12 right-0 w-10 h-10 bg-white/10 hover:bg-white/20 rounded-full flex items-center justify-center text-white transition-colors duration-300">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <div class="bg-white dark:bg-slate-900 rounded-2xl overflow-hidden">
      <div class="relative">
        <img id="lightbox-image" src="" alt="" class="w-full h-auto max-h-[80vh] object-contain">

        <button onclick="previousImage(event)" class="absolute left-4 top-1/2 -translate-y-1/2 w-12 h-12 bg-black/50 hover:bg-black/70 rounded-full flex items-center justify-center text-white transition-colors duration-300">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>

        <button onclick="nextImage(event)" class="absolute right-4 top-1/2 -translate-y-1/2 w-12 h-12 bg-black/50 hover:bg-black/70 rounded-full flex items-center justify-center text-white transition-colors duration-300">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>

      <div class="p-6 border-t border-slate-200 dark:border-slate-700">
        <div class="flex items-start justify-between gap-4">
          <div class="flex-1">
            <p id="lightbox-description" class="text-slate-700 dark:text-slate-300 text-lg mb-2"></p>
            <p id="lightbox-counter" class="text-sm text-slate-500 dark:text-slate-400"></p>
          </div>

          <button onclick="downloadImage()" class="flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-semibold text-sm transition-colors duration-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
            Descargar
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Array de fotos para el lightbox
  const photos = [
    <% if @photos&.any? %>
      <% @photos.each_with_index do |photo, index| %>
        {
          src: '<%= photo.blob.present? ? url_for(photo) : "" %>',
          description: '<%= "Foto #{index + 1}" %>',
          index: <%= index %>
        }<%= index < @photos.length - 1 ? ',' : '' %>
      <% end %>
    <% end %>
  ];

  let currentImageIndex = 0;

  function openLightbox(index) {
    currentImageIndex = index;
    updateLightboxImage();
    document.getElementById('lightbox').classList.remove('hidden');
    document.getElementById('lightbox').classList.add('flex');
    document.body.style.overflow = 'hidden'; // Prevenir scroll
  }

  function closeLightbox() {
    document.getElementById('lightbox').classList.add('hidden');
    document.getElementById('lightbox').classList.remove('flex');
    document.body.style.overflow = ''; // Restaurar scroll
  }

  function updateLightboxImage() {
    if (photos.length === 0) return;
    
    const photo = photos[currentImageIndex];
    document.getElementById('lightbox-image').src = photo.src;
    document.getElementById('lightbox-image').alt = photo.description;
    document.getElementById('lightbox-description').textContent = photo.description;
    document.getElementById('lightbox-counter').textContent = `Foto ${currentImageIndex + 1} de ${photos.length}`;
  }

  function nextImage(event) {
    event.stopPropagation();
    currentImageIndex = (currentImageIndex + 1) % photos.length;
    updateLightboxImage();
  }

  function previousImage(event) {
    event.stopPropagation();
    currentImageIndex = (currentImageIndex - 1 + photos.length) % photos.length;
    updateLightboxImage();
  }

  function downloadImage() {
    const photo = photos[currentImageIndex];
    const link = document.createElement('a');
    link.href = photo.src;
    link.download = `olimpiadas-foto-${currentImageIndex + 1}.jpg`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  }

  // Cerrar con tecla ESC
  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
      closeLightbox();
    } else if (event.key === 'ArrowRight') {
      nextImage(event);
    } else if (event.key === 'ArrowLeft') {
      previousImage(event);
    }
  });
</script>
