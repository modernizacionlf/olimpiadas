<section class="content-section" aria-labelledby="news-title">
  <header class="news-hero">
    <div class="news-cover">
      <h2 id="news-title">PORTADA</h2>
      <div class="news-subtittle">
        <p>SUBTITULO</p>
        <aside class="news-next-preview" aria-label="Vista previa de la siguiente noticia">
          <p>VISTA PREVIA (solo portada)</p>
        </aside>
      </div>
    </div>
  </header>
</section>

<% if @games.any? %>
  <section class="content-section">
    <h2>Partidos</h2>
    <% @games.each do |game| %>
    <div class="game">
      <h4 class="game-instance"><%= game.instance.name.titleize %></h4>
      <div class="game-teams">
        <p>Equipo1</p>
        <p>
          <span><%= game.result_a %></span>
          -
          <span><%= game.result_b %></span>
        </p>
        <p>Equipo2</p>
      </div>
    </div>
  <% end %>
</section>
<% end %> 

<section class="content-section">
  <h3>Momentos destacados...</h3>
  <div class="photos">
    <div>
      <img>Foto1</img> 
      <p>nombre</p>
    </div> 
  </div>
  <%= link_to "Ver más", gallery_index_path %>
</section>
