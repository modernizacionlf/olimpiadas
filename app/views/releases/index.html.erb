<h2>NOTICIAS</h2>
<div class="best-release">
  <img>Portada</img>
  <h3>Titulo</h3>
  <p>Subtitulo</p>
</div>
<% if @releases.any? %>
  <% @releases.each do |release| %>
    <div class="release">
      <img>Portada</img>
      <h5><%= link_to release.title.titleize, release_path(release) %></h5>
      <p><%= release.description.capitalize %></p>
    </div>
  <% end %>
<% end %>
