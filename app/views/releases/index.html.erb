<h2>NOTICIAS</h2>
<% if @most_viewed.present? %>
  <div class="most_viewed-release">
    <% if @most_viewed.image.attached? %>
      <img src=<%= url_for(@most_viewed.image) %>></img>
    <% end %>
    <h3><%= @most_viewed.title.titleize %></h3>
    <p><%= @most_viewed.description.capitalize %></p>
  </div>
<% end %>

<% if @releases.any? %>
  <% @releases.each do |release| %>
    <div class="release">
      <% if release.image.attached? %>
        <img src=<%= url_for(release.image) %>></img>
      <% end %>
      <h5><%= link_to release.title.titleize, release_path(release) %></h5>
      <p><%= release.description.capitalize %></p>
    </div>
  <% end %>
<% end %>
