<div class="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-50 dark:from-slate-900 dark:via-slate-800 dark:to-slate-900">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="mb-16">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-6">
        <div>
          <h2 class="text-5xl sm:text-6xl lg:text-7xl font-bold text-slate-900 dark:text-white mb-3 tracking-tight">
            Noticias
          </h2>
        </div>
      </div>
    </div>

    <% if @most_viewed.present? %>
      <%= link_to release_path(@most_viewed), class: "block mb-20 group" do %>
        <article class="bg-white dark:bg-slate-800 border-1 border-solid border-neutral-300 hover:border-blue-600 dark:border-slate-700 rounded-3xl transition-all duration-500 overflow-hidden">
          <div class="grid lg:grid-cols-2 gap-0">
            <div class="relative overflow-hidden h-80 lg:h-auto">
              <% if @most_viewed.image.attached? %>
                <%= image_tag @most_viewed.image,
                    class: "w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700",
                    alt: @most_viewed.title %>
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent lg:bg-gradient-to-r"></div>
              <% else %>
                <div class="w-full h-full bg-neutral-50 flex items-center justify-center">
                  <svg class="w-24 h-24 text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                  </svg>
                </div>
              <% end %>

              <div class="absolute top-6 left-6">
                <span class="inline-flex items-center gap-2 px-4 py-2 bg-amber-500 text-white text-sm font-bold rounded-full">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                  Más Vista
                </span>
              </div>
            </div>

            <div class="p-8 lg:p-12 flex flex-col justify-center">
              <div class="space-y-5">
                <h3 class="text-3xl lg:text-4xl font-bold text-slate-900 dark:text-white leading-tight group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors duration-300">
                  <%= @most_viewed.title.titleize %>
                </h3>

                <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
                  <%= @most_viewed.description.capitalize %>
                </p>

                <div class="pt-4">
                  <span class="inline-flex items-center gap-2 text-blue-600 dark:text-blue-400 font-semibold text-lg group-hover:gap-3 transition-all duration-300">
                    Leer más
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
                    </svg>
                  </span>
                </div>

                <% if @most_viewed.respond_to?(:created_at) %>
                  <div class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400 pt-2 border-t border-slate-200 dark:border-slate-700">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    <%= @most_viewed.created_at.strftime("%d de %B, %Y") %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </article>
      <% end %>
    <% end %>

    <% if @releases.any? %>
      <div class="space-y-6">
        <div class="flex items-center justify-between mb-8">
          <h3 class="text-2xl font-bold text-slate-900 dark:text-white">
            Todas las Noticias
          </h3>
          <div class="h-px flex-1 bg-gradient-to-r from-slate-300 to-transparent dark:from-slate-700 ml-6"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          <% @releases.each do |release| %>
            <%= link_to release_path(release), class: "group block" do %>
              <article class="bg-white dark:bg-slate-800 rounded-2xl border-1 border-solid border-neutral-300 hover:border-blue-600 dark:border-slate-700 transition-all duration-300 overflow-hidden h-full flex flex-col hover:-translate-y-1">
                <div class="relative h-56 overflow-hidden">
                  <% if release.image.attached? %>
                    <%= image_tag release.image,
                        class: "w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500",
                        alt: release.title %>
                    <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                  <% else %>
                    <div class="w-full h-full bg-neutral-50 to-purple-500 flex items-center justify-center">
                      <svg class="w-16 h-16 text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                      </svg>
                    </div>
                  <% end %>
                </div>

                <div class="p-6 flex-1 flex flex-col">
                  <h5 class="text-xl font-bold text-slate-900 dark:text-white mb-3 leading-tight line-clamp-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors duration-300">
                    <%= release.title.titleize %>
                  </h5>

                  <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed line-clamp-3 mb-4 flex-1">
                    <%= release.description.capitalize %>
                  </p>

                  <div class="flex items-center justify-between pt-4 border-t border-slate-200 dark:border-slate-700">
                    <span class="text-blue-600 dark:text-blue-400 font-semibold text-sm group-hover:underline">
                      Leer artículo
                    </span>
                    <svg class="w-5 h-5 text-blue-600 dark:text-blue-400 transform group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                  </div>
                </div>
              </article>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
